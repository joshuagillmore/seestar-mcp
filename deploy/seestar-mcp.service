# Hardened, unprivileged systemd unit for seestar-mcp on the Jetson.
#
# BEFORE USE, fill in for your target host:
#   <SEESTAR_IP>  - the Seestar's fixed LAN IP (DHCP reservation, station mode)
#   User/Group    - a dedicated NON-ROOT service account (e.g. `seestar`)
#   paths         - WorkingDirectory, ExecStart --directory, ReadWritePaths
#
# This unit MUST NOT run as root, and it opens NO listening socket: seestar-mcp
# speaks MCP over stdio. Remote Control's outbound HTTPS to Anthropic is made by
# the separate Claude Code process, NOT by this unit. This unit's only egress is
# to localhost (seestar_alp :5555) and the Seestar's data ports on the LAN.
#
# AFTER DEPLOY, verify the hardening actually took effect:
#   systemd-analyze verify seestar-mcp.service
#   systemd-analyze security seestar-mcp
# (2026-09-22 review: a stray inline `#` on seven directives here silently
# dropped them — systemd only warns to the log, it doesn't fail the unit — so
# a one-time verify after any edit to this file is the only way to catch it.)
#
# THEN SMOKE-TEST STARTUP — the hardening is NEW, not just re-verified. Before
# 2026-09-22 those seven directives never applied, so this service has never
# run under them. With ProtectSystem=strict + ProtectHome=yes, `uv run` (the
# ExecStart below) may be unable to write its cache (default ~/.cache/uv) or
# /opt/seestar-mcp/.venv, and fail at startup. Not verifiable without the
# Jetson, so check on first deploy:
#   sudo systemctl daemon-reload && sudo systemctl restart seestar-mcp
#   journalctl -u seestar-mcp -n 50
# and look for uv failing with "Read-only file system" or "Permission denied"
# on a cache or .venv path. Likely remedies:
#   - pre-sync the env at deploy time (`uv sync --frozen`, as the service user)
#     and launch with `uv run --frozen --no-sync ...`, so uv writes nothing;
#   - point uv's cache at a writable path, e.g.
#     `Environment=UV_CACHE_DIR=/opt/seestar-mcp/data/.uv-cache` (already
#     under ReadWritePaths);
#   - or add the cache path to ReadWritePaths.
# A uv-managed Python under the service user's /home is hidden by
# ProtectHome=yes too; give the account a home outside /home, or build the
# venv on a system Python.

[Unit]
Description=seestar-mcp (auditable MCP server for the ZWO Seestar S50)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# --- run as a dedicated, unprivileged account (NEVER root) ---
User=seestar
Group=seestar

# --- working dir + launch via uv (uses the hash-locked env) ---
WorkingDirectory=/opt/seestar-mcp
ExecStart=/usr/bin/uv --directory /opt/seestar-mcp run python -m seestar_mcp.server

# --- process hardening / sandbox ---
# systemd has no inline comments: a trailing `#` on a directive line becomes
# part of the VALUE, not a comment, and the directive is silently dropped with
# only a log warning (found 2026-09-22 review; see CHANGELOG). Each directive's
# explanation lives on its own line above it instead.
NoNewPrivileges=yes
# entire filesystem read-only except ReadWritePaths
ProtectSystem=strict
# no access to /home, /root, /run/user
ProtectHome=yes
# private /tmp, /var/tmp
PrivateTmp=yes
# no physical device nodes (stdio MCP needs none)
PrivateDevices=yes
# /proc/sys, /sys read-only
ProtectKernelTunables=yes
# cgroup hierarchy read-only
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
# no W^X pages
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service

# --- least-privilege writable paths (ONLY the data/manifests dir) ---
ReadWritePaths=/opt/seestar-mcp/data

# --- egress allowlist: localhost + the Seestar (+ weather when enabled) ---
# Denies all outbound traffic, then re-allows loopback (seestar_alp :5555) and
# the Seestar's LAN IP (native JSON-RPC :4700, HTTP :80, SMB :445). This unit
# has NO reason to reach anything else; Remote Control's HTTPS is a different
# process. Replace <SEESTAR_IP> with the device's fixed address.
#
# WEATHER: the observing planner makes ONE external call — HTTPS :443 to
# api.open-meteo.com (keyless, no secret). If you enable weather, that host must
# be reachable. IPAddressAllow pins IPs, not DNS names, and Open-Meteo's IPs
# rotate, so you cannot cleanly IP-pin it here — either resolve-and-pin its
# current addresses at deploy time, or relax this allowlist to permit :443
# egress. It is the only allowed outbound weather destination.
IPAddressDeny=any
IPAddressAllow=localhost <SEESTAR_IP>

# --- restart policy ---
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
